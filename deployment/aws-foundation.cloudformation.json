{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Musiyo demonstration foundation. Owner approval and verified Free account coverage required; never executed by local preparation.",
  "Parameters": {
    "AmiId": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Owner-approved Amazon Linux 2023 x86_64 AMI in the selected deployment Region; resolve and record its exact id before deployment."
    },
    "CloudFrontPrefixListId": {
      "Type": "String",
      "AllowedPattern": "pl-[a-f0-9]+",
      "Description": "Managed CloudFront origin-facing IPv4 prefix list in the selected deployment Region, resolved before owner approval."
    },
    "WebOrigin": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(^$|^https://[a-z0-9][a-z0-9.-]+$)",
      "Description": "Optional exact approved HTTPS web origin for private resource CORS; set after the distribution URL is known."
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.42.0.0/24",
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway"
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.0.0/25",
        "MapPublicIpOnLaunch": true
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "DefaultRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "SubnetRoute": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "SubnetId": {
          "Ref": "Subnet"
        }
      }
    },
    "ContentBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "limit-old-versions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 14
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        },
        "CorsConfiguration": {
          "Fn::If": [
            "HasWebOrigin",
            {
              "CorsRules": [
                {
                  "AllowedOrigins": [
                    {
                      "Ref": "WebOrigin"
                    }
                  ],
                  "AllowedMethods": [
                    "GET",
                    "HEAD"
                  ],
                  "AllowedHeaders": [
                    "Range",
                    "If-None-Match",
                    "If-Modified-Since"
                  ],
                  "ExposedHeaders": [
                    "ETag",
                    "Content-Length",
                    "Content-Type"
                  ],
                  "MaxAge": 300
                }
              ]
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "BackupBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "limit-old-versions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 14
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      }
    },
    "InstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "read-private-content",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${ContentBucket.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ContentBucket",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "InstanceRole"
          }
        ]
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "HTTPS from CloudFront and public ACME HTTP; no database or SSH exposure",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "SourcePrefixListId": {
              "Ref": "CloudFrontPrefixListId"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "Instance": {
      "Type": "AWS::EC2::Instance",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "DependsOn": "DefaultRoute",
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": "t3.small",
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "IamInstanceProfile": {
          "Ref": "InstanceProfile"
        },
        "SubnetId": {
          "Ref": "Subnet"
        },
        "SecurityGroupIds": [
          {
            "Ref": "SecurityGroup"
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 2
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeType": "gp3",
              "VolumeSize": 30,
              "Encrypted": true,
              "DeleteOnTermination": false
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Musiyo"
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/usr/bin/env bash\n# Host preparation only: no database migration, cultural import or secret values.\nset -euo pipefail\n\ndnf install -y docker ca-certificates\n# Amazon Linux 2023 supplies curl-minimal; installing curl conflicts with it.\ncommand -v curl > /dev/null\nsystemctl enable --now docker\ninstall -d -m 0750 /opt/musiyo /opt/musiyo/release /opt/musiyo/backups\ninstall -d -m 0700 -o 10001 -g 10001 /opt/musiyo/config /opt/musiyo/secrets\ninstall -d -m 0755 /usr/local/lib/docker/cli-plugins\n\ncompose_version=v2.40.3\ncompose_sha256=dba9d98e1ba5bfe11d88c99b9bd32fc4a0624a30fafe68eea34d61a3e42fd372\ncompose_file=$(mktemp)\ntrap 'rm -f \"$compose_file\"' EXIT\ncurl --fail --silent --show-error --location --retry 3 \\\n  \"https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64\" \\\n  --output \"$compose_file\"\nprintf '%s  %s\\n' \"$compose_sha256\" \"$compose_file\" | sha256sum --check --status\ninstall -m 0755 \"$compose_file\" /usr/local/lib/docker/cli-plugins/docker-compose\ntest \"$(docker compose version --short)\" = \"${compose_version#v}\"\n\ncat > /etc/systemd/system/musiyo.service <<'SERVICE'\n[Unit]\nDescription=Musiyo museum containers\nRequires=docker.service\nAfter=docker.service network-online.target\nWants=network-online.target\nConditionPathExists=/opt/musiyo/config/runtime.env\nConditionPathExists=/opt/musiyo/release/compose.demo.yml\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nWorkingDirectory=/opt/musiyo/release\nExecStartPre=/usr/bin/docker compose --env-file /opt/musiyo/config/runtime.env -f compose.demo.yml config --quiet\nExecStart=/usr/bin/docker compose --env-file /opt/musiyo/config/runtime.env -f compose.demo.yml up -d --no-build\nExecStop=/usr/bin/docker compose --env-file /opt/musiyo/config/runtime.env -f compose.demo.yml stop\nTimeoutStartSec=600\n\n[Install]\nWantedBy=multi-user.target\nSERVICE\nsystemctl daemon-reload\n# Enable recovery after a reboot, but do not start an unconfigured application.\nsystemctl enable musiyo.service\n"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "One modest container host; role-based private reads and SSM avoid static AWS keys or SSH.",
          "must": [
            "Bootstrap never imports data, runs migrations or embeds secrets.",
            "Retain the database disk; preserve IMDSv2 and bounded CPU credits.",
            "Docker Compose binary must match its pinned SHA-256."
          ]
        }
      }
    },
    "StaticAddress": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      }
    },
    "AddressAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "StaticAddress",
            "AllocationId"
          ]
        },
        "InstanceId": {
          "Ref": "Instance"
        }
      }
    },
    "ContentBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Require encrypted transport for retained private data.",
          "must": [
            "No public grant or runtime upload permission."
          ]
        }
      },
      "Properties": {
        "Bucket": {
          "Ref": "ContentBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ContentBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${ContentBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": false
                }
              }
            }
          ]
        }
      }
    },
    "BackupBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Require encrypted transport for retained private data.",
          "must": [
            "No public grant or runtime upload permission."
          ]
        }
      },
      "Properties": {
        "Bucket": {
          "Ref": "BackupBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "BackupBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${BackupBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": false
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Instance"
      },
      "Description": "Approved container host identifier."
    },
    "PublicAddress": {
      "Value": {
        "Ref": "StaticAddress"
      },
      "Description": "Elastic IPv4 address for the owner-controlled API DNS name."
    },
    "ContentBucketName": {
      "Value": {
        "Ref": "ContentBucket"
      },
      "Description": "Private runtime-read content bucket."
    },
    "BackupBucketName": {
      "Value": {
        "Ref": "BackupBucket"
      },
      "Description": "Private backup bucket, separate from runtime reads."
    }
  },
  "Conditions": {
    "HasWebOrigin": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "WebOrigin"
            },
            ""
          ]
        }
      ]
    }
  },
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    },
    "com.aws.cloudformation.Context": {
      "must": [
        "Owner resource approval and verified Free-plan coverage before application; no own spend.",
        "Regional resources stay in the selected Region; global endpoints do not change that selection.",
        "Database ports remain private; HTTP ingress is only for Caddy ACME/HTTPS redirection."
      ],
      "ref": [
        {
          "at": "OPERATIONS.txt",
          "has": "deployment, retention and restore boundaries"
        }
      ]
    }
  }
}
