MUSIYO_DATABASE_URL=sqlite:///./musiyo.db
MUSIYO_STORAGE_ROOT=storage
MUSIYO_DB_PASSWORD=
MUSIYO_S3_ACCESS_KEY=
MUSIYO_S3_SECRET_KEY=
MUSIYO_STORAGE_BACKEND=local
MUSIYO_RESOURCE_SIGNING_KEY=
MUSIYO_S3_ENDPOINT=http://127.0.0.1:9000
MUSIYO_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MUSIYO_S3_BUCKET=musiyo-private
MUSIYO_S3_REGION=us-east-1
MUSIYO_WEB_ORIGIN=http://localhost:5173

# Local textual guide only; external providers are not enabled.
MUSIYO_GUIDE_GENERATION=local
MUSIYO_GUIDE_CANDIDATE_LIMIT=8
MUSIYO_GUIDE_EVIDENCE_LIMIT=4
MUSIYO_GUIDE_MINIMUM_COVERAGE=0.5
MUSIYO_GUIDE_QUESTIONS_PER_MINUTE=10
