{
  "$defs": {
    "QuizCitation": {
      "additionalProperties": false,
      "properties": {
        "element_slug": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Element Slug",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "element_slug",
        "source_id",
        "quote"
      ],
      "title": "QuizCitation",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "publication",
            "interview",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "id",
        "kind",
        "reference"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Id",
      "type": "string"
    },
    "correct": {
      "title": "Correct",
      "type": "boolean"
    },
    "explanation": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Explanation",
      "type": "string"
    },
    "citation": {
      "$ref": "#/$defs/QuizCitation"
    },
    "source": {
      "$ref": "#/$defs/Source"
    }
  },
  "required": [
    "schema_version",
    "id",
    "correct",
    "explanation",
    "citation",
    "source"
  ],
  "title": "GuideQuizAnswerResult",
  "type": "object"
}
