            },
            "type": "array",
            "title": "Collections"
          },
          "technique": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Technique"
          },
          "materials": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Materials"
          },
