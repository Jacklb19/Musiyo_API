  "components": {
    "schemas": {
      "CatalogFacet": {
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "element_count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Element Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "slug",
          "name",
          "element_count"
        ],
        "title": "CatalogFacet"
      },
      "CatalogItem": {
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$",
            "title": "Slug"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "community": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Community"
          },
          "thumbnail_resource_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumbnail Resource Id"
          },
          "has_3d_model": {
            "type": "boolean",
            "title": "Has 3D Model",
            "default": false
          },
          "has_narration": {
            "type": "boolean",
            "title": "Has Narration",
            "default": false
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NamedTerm"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "slug",
          "title",
          "description"
        ],
        "title": "CatalogItem"
      },
      "CatalogPage": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CatalogItem"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Offset"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "CatalogPage"
      },
      "Community": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "people": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$",
            "title": "People"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "people"
        ],
        "title": "Community"
      },
      "Credit": {
        "properties": {
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "name": {
            "type": "string",
            "title": "Name"
