{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "question": {
      "maxLength": 500,
      "minLength": 3,
      "title": "Question",
      "type": "string"
    },
    "element_slug": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Element Slug"
    }
  },
  "required": [
    "schema_version",
    "question"
  ],
  "title": "GuideQuestion",
  "type": "object"
}
