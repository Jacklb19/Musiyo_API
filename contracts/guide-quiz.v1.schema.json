{
  "$defs": {
    "QuizOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 250,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "QuizOption",
      "type": "object"
    },
    "QuizQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/QuizOption"
          },
          "maxItems": 4,
          "minItems": 3,
          "title": "Options",
          "type": "array"
        },
        "element_slug": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Element Slug",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "options",
        "element_slug",
        "source_id"
      ],
      "title": "QuizQuestion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "tour_key": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Tour Key",
      "type": "string"
    },
    "room_key": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Room Key"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/QuizQuestion"
      },
      "maxItems": 50,
      "title": "Questions",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "tour_key",
    "room_key",
    "questions"
  ],
  "title": "GuideQuiz",
  "type": "object"
}
